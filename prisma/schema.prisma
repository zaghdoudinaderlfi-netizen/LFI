// schema.prisma — Plateforme pédagogique Technologie / SNT (collège-lycée)
// Stack : Next.js + Prisma + PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────────────────────────
//  ÉNUMÉRATIONS
// ───────────────────────────────────────────────

enum Role {
  PROF
  ELEVE
}

enum Niveau {
  TROISIEME
  SECONDE
  PREMIERE
}

enum Matiere {
  TECHNOLOGIE
  SNT
  NSI
}

enum TypeExercice {
  PYTHON
  TURTLE
  QCM
  ARDUINO
  CODE_OUVERT
  DEVOIR_PDF
  DEVOIR_PDF_FORMULAIRE
}

// Pour un devoir DEVOIR_PDF_FORMULAIRE, mode de remise choisi par le prof :
// - EN_LIGNE : l'élève remplit les champs du PDF directement sur le site.
// - TELECHARGEMENT : l'élève télécharge le PDF-formulaire, le remplit dans
//   son propre lecteur PDF, puis dépose le fichier rempli (façon Capytale).
enum ModeRemiseFormulaire {
  EN_LIGNE
  TELECHARGEMENT
}

enum TypeContenuCours {
  HTML
  PDF
}

// Type choisi dans le formulaire de création simplifié (5 boutons). Null pour
// les cours composés via l'éditeur avancé existant (blocs, page interactive,
// import Word/PDF classique) — ce champ ne remplace pas ce système, il
// s'ajoute comme un mode de création alternatif et plus rapide.
enum TypeCoursSimple {
  HTML
  PDF
  WORD
  VIDEO
  QCM
}

enum TypeBloc {
  TEXTE
  IMAGE
  PDF
  VIDEO
  ACTIVITE
  LIEN
  EDITEUR_PYTHON
}

// ───────────────────────────────────────────────
//  UTILISATEURS & CLASSES
// ───────────────────────────────────────────────

model User {
  id         String  @id @default(cuid())
  email      String  @unique
  nom        String
  prenom     String?
  motDePasse String
  role       Role    @default(ELEVE)

  // Sécurité : force le changement de mdp après réinitialisation admin.
  doitChangerMdp Boolean @default(false)

  // Avatar (constructeur façon Kahoot, élèves uniquement). Null = avatar
  // par défaut généré à partir de l'identifiant (lib/avatar.ts).
  avatarStyle   String?
  avatarOptions Json?

  classe   Classe? @relation(fields: [classeId], references: [id])
  classeId String?

  soumissions    Soumission[]
  groupesMembre  MembreGroupe[]
  quizCrees      Quiz[]           @relation("AuteurQuiz")
  tentativesQuiz TentativeQuiz[]
  notifications  Notification[]
  tokensReinit   TokenReinitMdp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Token à usage unique pour la réinitialisation du mot de passe par email.
// Expire après 1 heure ; marqué utilisé dès qu'il a servi.
model TokenReinitMdp {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String   @unique
  expiresAt DateTime
  utilise   Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Classe {
  id              String @id @default(cuid())
  nom             String
  niveau          Niveau
  codeInscription String @unique
  anneeScolaire   String

  eleves        User[]
  comptesRendus CompteRendu[]

  createdAt DateTime @default(now())
}

// ───────────────────────────────────────────────
//  COURS & EXERCICES
// ───────────────────────────────────────────────

model Cours {
  id          String           @id @default(cuid())
  titre       String
  slug        String           @unique
  typeContenu TypeContenuCours @default(HTML)
  contenu     String           @db.Text
  niveau      Niveau
  matiere     Matiere
  ordre       Int              @default(0)
  publie      Boolean          @default(false)

  pdfNom      String?
  pdfChemin   String?
  pdfTaille   Int?
  pdfTypeMime String?

  // Fichier HTML interactif dans public/cours/ (ex: "nsi-ch1.html")
  pageInteractive String?

  // Titre affiché sur la carte de couverture (optionnel, prioritaire sur `titre`)
  titreInteractif String?

  // Image de couverture (chemin dans le bucket public images-cours-lfi)
  imageCouvertureChemin String?

  // Numéro de chapitre (optionnel) — permet de regrouper les cours par chapitre.
  chapitre Int?

  // Quand false, le cours n'apparaît pas côté élève (même s'il est publié).
  visibleEleves Boolean @default(true)

  // Quand true, le lien élève inclut ?corrige=1 (corrections affichées dans la page HTML)
  correctionVisible Boolean @default(false)

  // Quand true, le cours est accessible sans connexion via /decouvrir/[id].
  estPublic Boolean @default(false)

  // Un seul cours à la fois peut être mis en avant sur la page d'accueil
  // publique (unicité gérée côté serveur, pas de contrainte DB : voir la
  // route qui bascule ce champ).
  enVitrine Boolean @default(false)

  // ── Mode de création simplifié (5 boutons : HTML / PDF / WORD / VIDEO / QCM) ──
  // Null si le cours a été composé via l'éditeur avancé existant (blocs,
  // page interactive, import classique). Voir TypeCoursSimple ci-dessus.
  typeSimple TypeCoursSimple?

  // HTML / PDF / WORD (mode simplifié) : URL publique du fichier déposé
  // dans Supabase Storage (bucket "cours").
  fichierUrl String?

  // VIDEO (mode simplifié) : URL YouTube ou Vimeo brute collée par le prof.
  // L'ID d'embed est extrait à l'affichage, pas stocké.
  videoUrl String?

  // QCM (mode simplifié) : quiz existant du système Quiz/Question/Tentative,
  // réutilisé tel quel (pas de duplication). Lien libre : le quiz garde son
  // propre niveau/matière/visibleEleves indépendamment de ce cours.
  quiz   Quiz?   @relation(fields: [quizId], references: [id], onDelete: SetNull)
  quizId String?

  exercices     Exercice[]
  piecesJointes PieceJointe[]
  blocs         Bloc[]
  comptesRendus CompteRendu[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quizId])
}

// Compte-rendu déposé par un élève (ou un groupe) directement depuis la page
// HTML statique d'un cours interactif — voir le widget de dépôt dans
// public/cours/*.html. Pas de compte élève requis : la page est ouverte
// hors session, `noms` est donc une simple chaîne saisie librement (ex:
// "Ali Ben Salem, Sami Trabelsi" pour un groupe).
model CompteRendu {
  id        String   @id @default(cuid())
  cours     Cours    @relation(fields: [coursId], references: [id], onDelete: Cascade)
  coursId   String
  noms      String
  dateDepot DateTime @default(now())

  // Code saisi par l'élève dans chaque cellule de la page, au moment du
  // dépôt : JSON [{ exercice, code }]. Null pour les dépôts antérieurs à
  // cette fonctionnalité. Les cellules de correction ne sont pas capturées.
  travail String? @db.Text

  // Classe de l'élève connecté au moment du dépôt, relevée côté serveur
  // (l'élève ne la saisit pas). Null s'il a déposé sans être connecté.
  classe   Classe? @relation(fields: [classeId], references: [id], onDelete: SetNull)
  classeId String?

  @@index([coursId])
  @@index([classeId])
}

// Bloc de contenu de la "boîte à outils" : le prof compose un cours en
// empilant des blocs de différents types, affichés dans l'ordre (champ
// `ordre`) côté élève.
model Bloc {
  id      String   @id @default(cuid())
  cours   Cours    @relation(fields: [coursId], references: [id], onDelete: Cascade)
  coursId String
  type    TypeBloc
  ordre   Int      @default(0)

  // TEXTE : HTML (Tiptap, sanitizé) — VIDEO / LIEN / ACTIVITE : URL —
  // EDITEUR_PYTHON : consigne (texte brut)
  contenu String? @db.Text

  // EDITEUR_PYTHON : code Python pré-rempli dans l'éditeur (optionnel)
  codeDepart String? @db.Text

  // LIEN / ACTIVITE : libellé du bouton/lien
  titre String?

  // ACTIVITE : outil choisi (clé de OUTILS_ACTIVITE, ou nom libre si "Autre")
  outil String?

  // IMAGE / PDF : fichier stocké dans Supabase Storage
  fichierNom      String?
  fichierChemin   String?
  fichierTaille   Int?
  fichierTypeMime String?

  createdAt DateTime @default(now())

  @@index([coursId])
}

model PieceJointe {
  id       String @id @default(cuid())
  cours    Cours  @relation(fields: [coursId], references: [id], onDelete: Cascade)
  coursId  String
  nom      String
  chemin   String
  taille   Int
  typeMime String
  ordre    Int    @default(0)

  createdAt DateTime @default(now())

  @@index([coursId])
}

model Exercice {
  id             String       @id @default(cuid())
  cours          Cours        @relation(fields: [coursId], references: [id], onDelete: Cascade)
  coursId        String
  titre          String
  consigne       String       @db.Text
  type           TypeExercice
  codeDepart     String?      @db.Text
  sortieAttendue String?      @db.Text
  points         Int          @default(1)
  ordre          Int          @default(0)
  dateLimite     DateTime?

  sujetNom      String?
  sujetChemin   String?
  sujetTaille   Int?
  sujetTypeMime String?

  // DEVOIR_PDF_FORMULAIRE uniquement : mode de remise choisi par le prof.
  modeRemise ModeRemiseFormulaire @default(EN_LIGNE)

  soumissions Soumission[]
}

model Soumission {
  id                  String   @id @default(cuid())
  exercice            Exercice @relation(fields: [exerciceId], references: [id], onDelete: Cascade)
  exerciceId          String
  eleve               User     @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  eleveId             String
  contenu             String?  @db.Text
  reussi              Boolean  @default(false)
  note                Float?
  feedback            String?  @db.Text
  corrigeManuellement Boolean  @default(false)

  fichierNom      String?
  fichierChemin   String?
  fichierTaille   Int?
  fichierTypeMime String?

  membres MembreGroupe[]

  createdAt DateTime @default(now())

  @@index([eleveId])
  @@index([exerciceId])
}

// Travail en groupe (binôme/trio) : en plus de l'élève auteur de la
// Soumission (eleveId), 1 à 2 coéquipiers désignés par lui apparaissent ici.
// Le rendu, la note et l'appréciation s'appliquent à tous les membres.
model MembreGroupe {
  id           String     @id @default(cuid())
  soumission   Soumission @relation(fields: [soumissionId], references: [id], onDelete: Cascade)
  soumissionId String
  eleve        User       @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  eleveId      String

  createdAt DateTime @default(now())

  @@unique([soumissionId, eleveId])
  @@index([eleveId])
}

// ───────────────────────────────────────────────
//  PROGRESSION
// ───────────────────────────────────────────────

model Progression {
  id          String   @id @default(cuid())
  niveau      Niveau
  matiere     Matiere
  date        DateTime
  titre       String
  description String   @db.Text
  ordre       Int      @default(0)

  createdAt DateTime @default(now())
}

// ───────────────────────────────────────────────
//  QUIZ LUDIQUES
// ───────────────────────────────────────────────

// Quiz ludique en mode SOLO façon Kahoot : chaque élève joue quand il veut
// (pas de session en direct, pas de code PIN, pas d'hôte).
model Quiz {
  id      String  @id @default(cuid())
  titre   String
  niveau  Niveau
  matiere Matiere

  // Numéro de chapitre (optionnel) — regroupe les quiz comme les cours.
  chapitre Int?

  // Quand false, le quiz n'apparaît pas côté élève.
  visibleEleves Boolean @default(false)

  auteur   User   @relation("AuteurQuiz", fields: [auteurId], references: [id])
  auteurId String

  questions  QuestionQuiz[]
  tentatives TentativeQuiz[]

  // Cours (mode simplifié QCM) qui pointent vers ce quiz — lien libre,
  // un même quiz peut être réutilisé par plusieurs cours ou aucun.
  coursSimplifies Cours[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Question à 4 choix fixes (A/B/C/D), une seule bonne réponse.
model QuestionQuiz {
  id     String @id @default(cuid())
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId String

  enonce String @db.Text
  choixA String
  choixB String
  choixC String
  choixD String

  // Index de la bonne réponse : 0 = A, 1 = B, 2 = C, 3 = D.
  bonneReponse Int

  tempsLimiteSec Int @default(20)
  ordre          Int @default(0)

  reponses ReponseTentative[]

  @@index([quizId])
}

// Une tentative = une partie jouée en solo par un élève sur un quiz.
// L'élève peut rejouer ; on garde toutes les tentatives et on calcule le
// meilleur score à la volée pour le classement (pas de dénormalisation).
model TentativeQuiz {
  id     String @id @default(cuid())
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId String

  eleve   User   @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  eleveId String

  score          Int @default(0)
  bonnesReponses Int @default(0)

  // Série de bonnes réponses consécutives : compteur courant (remis à 0 sur
  // erreur/temps écoulé) et record atteint pendant la partie (pour les stats
  // prof et pour déverrouiller définitivement les power-ups de l'étape B).
  serieActuelle Int @default(0)
  serieMax      Int @default(0)

  reponses ReponseTentative[]

  createdAt DateTime @default(now())

  @@index([quizId])
  @@index([eleveId])
}

model ReponseTentative {
  id          String        @id @default(cuid())
  tentative   TentativeQuiz @relation(fields: [tentativeId], references: [id], onDelete: Cascade)
  tentativeId String
  question    QuestionQuiz  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId  String

  // Index choisi par l'élève (0-3), null si le temps est écoulé sans réponse.
  reponseDonnee Int?
  correct       Boolean @default(false)
  tempsMs       Int
  pointsObtenus Int     @default(0)

  // Multiplicateur de série appliqué à cette réponse (1, 1.2, 1.5 ou 2),
  // gardé pour audit/stats — le calcul fait foi côté serveur dans repondre().
  multiplicateurSerie Float @default(1)

  // Empêche de répondre deux fois à la même question dans une tentative.
  @@unique([tentativeId, questionId])
  @@index([tentativeId])
}

// ───────────────────────────────────────────────
//  LOGICIELS À TÉLÉCHARGER
// ───────────────────────────────────────────────

model Logiciel {
  id          String @id @default(cuid())
  titre       String
  description String @db.Text

  // Téléchargement : soit un lien externe, soit un fichier stocké dans
  // Supabase Storage (pas forcément les deux à la fois).
  lien String?

  fichierNom      String?
  fichierChemin   String?
  fichierTaille   Int?
  fichierTypeMime String?

  ordre Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────
//  NOTIFICATIONS
// ───────────────────────────────────────────────

model Notification {
  id             String  @id @default(cuid())
  destinataire   User    @relation(fields: [destinataireId], references: [id], onDelete: Cascade)
  destinataireId String
  message        String
  lien           String?
  lu             Boolean @default(false)

  // Matière d'origine (cours, devoir, correction...), pour permettre le
  // filtrage côté prof/élève. Null si la notification n'est pas rattachée
  // à une matière précise.
  matiere Matiere?

  createdAt DateTime @default(now())

  @@index([destinataireId])
}
